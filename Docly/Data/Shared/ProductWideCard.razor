<div class="card shadow-sm border-0 mb-3 rounded-4 list-item-hover">
    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center p-3">
        
        <!-- Info Paziente e Icona -->
        <div class="d-flex align-items-center mb-3 mb-md-0">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3 shadow-sm" style="width: 50px; height: 50px;">
                <i class="bi bi-person-fill fs-3"></i>
            </div>
            <div>
                <small class="text-uppercase text-muted fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Paziente</small>
                <h6 class="mb-0 fw-bold text-dark fs-5">@PatientName</h6>
            </div>
        </div>

        <!-- Info Data e Ora -->
        <div class="d-flex align-items-center mb-3 mb-md-0">
            <div class="me-4 d-flex align-items-center">
                <i class="bi bi-calendar-event text-secondary me-2 fs-5"></i>
                <div>
                    <small class="d-block text-muted" style="font-size: 0.7rem;">Data</small>
                    <span class="fw-semibold text-dark">@Date</span>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <i class="bi bi-clock text-secondary me-2 fs-5"></i>
                <div>
                    <small class="d-block text-muted" style="font-size: 0.7rem;">Orario</small>
                    <span class="fw-semibold text-dark">@Time</span>
                </div>
            </div>
        </div>

        <!-- Bottone Azione -->
        <div>
            <button class="btn btn-outline-primary rounded-pill px-4 fw-bold w-100" onclick="@OnClick">
                Apri <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </div>
        
    </div>
</div>

@code {
    [Parameter]
    public string PatientName { get; set; } = string.Empty;

    [Parameter]
    public string Date { get; set; } = string.Empty;

    [Parameter]
    public string Time { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnClick { get; set; }
}