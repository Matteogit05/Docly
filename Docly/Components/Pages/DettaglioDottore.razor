@page "/doctor/{DoctorId:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Docly.Data
@using Docly.Data.Shared
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<PageTitle>Dettaglio Medico - Docly</PageTitle>

<div class="container mt-5">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Caricamento...</span>
            </div>
        </div>
    }
    else if (doctor == null)
    {
        <div class="alert alert-danger shadow-sm">
            <i class="bi bi-exclamation-triangle"></i> Nessun medico trovato con questo ID oppure il medico non è più attivo.
        </div>
        <button class="btn btn-outline-primary mt-3" @onclick='() => NavManager.NavigateTo("/home")'>Torna alla Home</button>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-5">
                        
                        <!-- Intestazione Medico -->
                        <div class="d-flex align-items-center mb-4">
                            <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-4" style="width: 80px; height: 80px; font-size: 2rem;">
                                @doctor.FirstName[0]@doctor.LastName[0]
                            </div>
                            <div>
                                <h2 class="mb-1 fw-bold text-dark">Dr. @doctor.FirstName @doctor.LastName</h2>
                                <h5 class="text-secondary mb-0"><i class="bi bi-briefcase-fill me-2"></i>@doctor.Specialization</h5>
                            </div>
                        </div>

                        <hr class="mb-4" />

                        <!-- Biografia -->
                        <h5 class="fw-bold mb-3">Informazioni</h5>
                        <p class="text-muted mb-5" style="line-height: 1.7;">
                            @(string.IsNullOrWhiteSpace(doctor.Bio) ? "Nessuna biografia disponibile per questo medico." : doctor.Bio)
                        </p>

                        <!-- Pulsanti d'Azione (Solo per Pazienti) -->
                        <AuthorizeView Roles="Patient">
                            <Authorized>
                                <div class="d-flex gap-3 flex-wrap">
                                    
                                    <!-- Pulsante Preferiti con due stati -->
                                    <button class="btn @(isFavorite ? "btn-outline-danger" : "btn-outline-primary") px-4 py-2 fw-bold" 
                                            @onclick="ToggleFavorite">
                                        @if (isFavorite)
                                        {
                                            <span><i class="bi bi-star-fill me-2"></i>Rimuovi dai tuoi dottori</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-star me-2"></i>Aggiungi ai tuoi dottori</span>
                                        }
                                    </button>

                                    <!-- Pulsante Apri Chat -->
                                    <button class="btn btn-primary px-4 py-2 fw-bold" @onclick="OpenChat">
                                        <i class="bi bi-chat-dots-fill me-2"></i>Apri chat
                                    </button>

                                </div>
                            </Authorized>
                        </AuthorizeView>

                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int DoctorId { get; set; }

    private Doctor? doctor;
    private bool isLoading = true;
    private bool isFavorite = false;
    private int? currentPatientId;

    protected override async Task OnInitializedAsync()
    {
        // 1. Carica i dati del medico in base all'ID passato nell'URL
        doctor = await Db.Doctors
            .AsNoTracking()
            .FirstOrDefaultAsync(d => d.Id == DoctorId && d.IsActive);

        if (doctor != null)
        {
            // 2. Identifica il paziente loggato per gestire i preferiti
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true && user.IsInRole("Patient"))
            {
                var identityUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

                if (identityUserId != null)
                {
                    var patient = await Db.Patients
                        .AsNoTracking()
                        .FirstOrDefaultAsync(p => p.IdentityUserId == identityUserId);

                    if (patient != null)
                    {
                        currentPatientId = patient.Id;

                        // 3. Verifica se il medico è già tra i preferiti di questo paziente
                        isFavorite = await Db.FavoriteDoctors
                            .AnyAsync(f => f.PatientId == currentPatientId && f.DoctorId == DoctorId);
                    }
                }
            }
        }

        isLoading = false;
    }

    private async Task ToggleFavorite()
    {
        if (currentPatientId == null || doctor == null) return;

        if (isFavorite)
        {
            // Se è già preferito, rimuovilo
            var fav = await Db.FavoriteDoctors.FindAsync(currentPatientId.Value, DoctorId);
            if (fav != null)
            {
                Db.FavoriteDoctors.Remove(fav);
                await Db.SaveChangesAsync();
                isFavorite = false;
            }
        }
        else
        {
            // Se non è preferito, aggiungilo
            var fav = new FavoriteDoctor { PatientId = currentPatientId.Value, DoctorId = DoctorId };
            Db.FavoriteDoctors.Add(fav);
            await Db.SaveChangesAsync();
            isFavorite = true;
        }
    }

    private void OpenChat()
    {
        // Naviga verso la futura pagina della chat per il medico specifico
        // NavManager.NavigateTo($"/chat/{DoctorId}");
    }
}