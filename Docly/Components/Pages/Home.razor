@page "/home"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Docly.Data
@using Docly.Data.Shared
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<PageTitle>Dashboard - Docly</PageTitle>

<div class="container-fluid mt-4">
    <AuthorizeView Roles="Admin">
        <Authorized>
            <div class="row">
                <div class="col-12">
                    <h2 class="text-danger"><i class="bi bi-shield-lock"></i> Pannello Amministratore</h2>
                    <p>Benvenuto nell'area di gestione. Da qui potrai gestire utenti, medici e sistema.</p>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Doctor">
        <Authorized>
            <div class="row">
                <div class="col-12">
                    <h2 class="text-success"><i class="bi bi-heart-pulse"></i> Area Medico</h2>
                    <p>Qui puoi visualizzare i tuoi appuntamenti, le disponibilità e i pazienti.</p>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Patient">
        <Authorized>
            <div class="row mb-3">
                <div class="col-12">
                    <h2 class="text-primary"><i class="bi bi-person-badge"></i> Area Paziente</h2>
                    <p>Cerca il tuo specialista e prenota una visita.</p>
                </div>
            </div>

            <!-- SEZIONE: I MIEI DOTTORI (PREFERITI) -->
            <div class="row mb-2">
                <div class="col-12">
                    <h4 class="text-secondary"><i class="bi bi-star-fill text-warning"></i> I miei Dottori</h4>
                </div>
            </div>
            
            <div class="row g-4 mb-5">
                @if (favoriteDoctors == null || !favoriteDoctors.Any())
                {
                    <div class="col-12">
                        <p class="text-muted fst-italic">Non hai nessun medico preferito.</p>
                    </div>
                }
                else
                {
                    @foreach (var doctor in favoriteDoctors)
                    {
                        <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                            <ProductCard 
                                Title="@($"Dr. {doctor.FirstName} {doctor.LastName}")"
                                Subtitle="@doctor.Specialization"
                                Description="@doctor.Bio"
                                TextButton="Prenota"
                                Badge="Preferito"
                                OnClick="() => PrenotaVisita(doctor.Id)" />
                        </div>
                    }
                }
            </div>

            <!-- SEZIONE: RICERCA GLOBALE -->
            <div class="row mb-2">
                <div class="col-12">
                    <h4 class="text-secondary"><i class="bi bi-search"></i> Trova uno Specialista</h4>
                </div>
            </div>

            <!-- Barra di Ricerca con Form per il tasto INVIO -->
            <div class="row mb-4">
                <div class="col-md-8 col-lg-6">
                    <form @onsubmit="SearchDoctors">
                        <div class="input-group shadow-sm">
                            <input type="text" class="form-control" placeholder="Cerca medico o specializzazione..." @bind="searchTerm" />
                            <button type="submit" class="btn btn-primary">
                                Cerca
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Griglia dei Risultati di Ricerca -->
            <div class="row g-4 mb-4">
                @if (searchResults == null)
                {
                    <!-- Nessuna ricerca ancora effettuata -->
                }
                else if (!searchResults.Any())
                {
                    <div class="col-12">
                        <div class="alert alert-warning shadow-sm"><i class="bi bi-info-circle"></i> Nessun medico trovato per la ricerca "@searchTerm".</div>
                    </div>
                }
                else
                {
                    @foreach (var doctor in searchResults)
                    {
                        <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                            <ProductCard 
                                Title="@($"Dr. {doctor.FirstName} {doctor.LastName}")"
                                Subtitle="@doctor.Specialization"
                                Description="@doctor.Bio"
                                TextButton="Prenota"
                                OnClick="() => PrenotaVisita(doctor.Id)" />
                        </div>
                    }
                }
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private string searchTerm = "";
    
    // Lista per la ricerca globale
    private List<Doctor>? searchResults = null; 
    
    // Lista per i medici preferiti dell'utente
    private List<Doctor> favoriteDoctors = new();
    
    private int? currentPatientId;

    protected override async Task OnInitializedAsync()
    {
        // 1. Identifica l'utente loggato
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true && user.IsInRole("Patient"))
        {
            var identityUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            
            if (identityUserId != null)
            {
                // 2. Trova il Paziente collegato per prenderne l'ID
                var patient = await Db.Patients.AsNoTracking().FirstOrDefaultAsync(p => p.IdentityUserId == identityUserId);
                
                if (patient != null)
                {
                    currentPatientId = patient.Id;
                    
                    // 3. Carica INTERAMENTE i medici preferiti (usando Include per prendere i dati di Doctors)
                    favoriteDoctors = await Db.FavoriteDoctors
                        .AsNoTracking()
                        .Include(f => f.Doctor)
                        .Where(f => f.PatientId == currentPatientId && f.Doctor.IsActive)
                        .Select(f => f.Doctor)
                        .ToListAsync();
                }
            }
        }
    }

    private async Task SearchDoctors()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            // Se la ricerca è vuota, carichiamo tutti i medici
            searchResults = await Db.Doctors
                .AsNoTracking()
                .Where(d => d.IsActive)
                .ToListAsync();
        }
        else
        {
            // Usiamo EF.Functions.Like per una ricerca non case-sensitive affidabile in SQLite
            var term = $"%{searchTerm}%";
            searchResults = await Db.Doctors
                .AsNoTracking()
                .Where(d => d.IsActive && 
                       (EF.Functions.Like(d.FirstName, term) || 
                        EF.Functions.Like(d.LastName, term) || 
                        EF.Functions.Like(d.Specialization, term)))
                .ToListAsync();
        }
    }

    private void PrenotaVisita(int doctorId)
    {
        NavManager.NavigateTo($"/doctor/{doctorId}");
    }
}