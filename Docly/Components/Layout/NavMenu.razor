@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand text-white fw-bold" href="/">
            <i class="bi bi-heart-pulse-fill me-2 text-white"></i> Docly
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column mt-2">
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill me-3 text-white fs-5" aria-hidden="true"></i> 
                <span class="text-white">Home</span>
            </NavLink>
        </div>

        <AuthorizeView Roles="Patient">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="agenda">
                        <i class="bi bi-calendar-check-fill me-3 text-white fs-5" aria-hidden="true"></i> 
                        <span class="text-white">Agenda</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="chat">
                        <i class="bi bi-chat-dots-fill me-3 text-white fs-5" aria-hidden="true"></i> 
                        <span class="text-white">Messaggi</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="me">
                        <i class="bi bi-person-circle me-3 text-white fs-5" aria-hidden="true"></i> 
                        <span class="text-white">Me</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Doctor">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="agenda">
                        <i class="bi bi-calendar-check-fill me-3 text-white fs-5" aria-hidden="true"></i> 
                        <span class="text-white">La mia Agenda</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="chat">
                        <i class="bi bi-chat-dots-fill me-3 text-white fs-5" aria-hidden="true"></i> 
                        <span class="text-white">Messaggi</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="me">
                        <i class="bi bi-person-circle me-3 text-white fs-5" aria-hidden="true"></i> 
                        <span class="text-white">Me</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="utenti">
                        <i class="bi bi-people-fill me-3 text-white fs-5" aria-hidden="true"></i> 
                        <span class="text-white">Gestione Utenti</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>
</div>